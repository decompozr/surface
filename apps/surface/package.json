{
  "name": "@decompozr/surface-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun server/index.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "bun --bun vite build",
    "start": "bun server/index.ts",
    "test": "bun run build && bun test server/host.test.ts",
    "verify:fixture": "bun run build && bun scripts/verify-fixture.ts",
    "verify:workspaces": "bun run build && bun scripts/verify-workspaces.ts",
    "verify:interactions": "bun run build && bun scripts/verify-interactions.ts",
    "verify:examples": "bun run build && bun scripts/verify-default-examples.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "html-to-image": "1.11.13",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.1",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "version": "0.0.0",
  "packageManager": "bun@1.4.0"
}
