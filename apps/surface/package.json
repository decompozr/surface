{
  "name": "@decompozr/surface-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun src/server.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "bun --bun vite build",
    "start": "bun src/server.ts",
    "test": "bun test tests",
    "check:core": "tsc --noEmit -p tsconfig.core.json"
  },
  "dependencies": {
    "@decompozr/design-system": "link:@decompozr/design-system",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "html-to-image": "1.11.13",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.1",
    "vite": "8.3.0",
    "@clack/prompts": "1.8.1",
    "ajv": "8.20.0",
    "ws": "8.21.3",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5",
    "@decompozr/surface-agent-adapters": "workspace:*",
    "@decompozr/surface-client": "workspace:*",
    "@decompozr/surface-contracts": "workspace:*",
    "@decompozr/surface-page-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/bun": "1.4.2",
    "svelte-check": "4.7.6",
    "@playwright/test": "1.63.0",
    "@types/ws": "8.18.1",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "version": "0.0.0",
  "packageManager": "bun@1.4.0",
  "exports": {
    "./server/*": "./src/lib/server/*.ts"
  }
}
