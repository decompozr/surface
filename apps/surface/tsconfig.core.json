{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/adapters/**/*.ts",
    "src/core/**/*.ts",
    "src/client/**/*.ts",
    "src/cli/**/*.ts",
    "src/installation/**/*.ts",
    "src/server/**/*.ts",
    "src/runtime/**/*.ts",
    "src/workspaces/**/*.ts",
    "tests/**/*.ts"
  ]
}
