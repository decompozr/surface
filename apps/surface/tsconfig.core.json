{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/lib/server/**/*.ts",
    ".svelte-kit/ambient.d.ts",
    "src/lib/comments/**/*.ts"
  ]
}
