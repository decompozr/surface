{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "apps/surface/src/adapters/**/*.ts",
    "apps/surface/src/core/**/*.ts",
    "apps/surface/src/client/**/*.ts",
    "apps/surface/src/cli/**/*.ts",
    "apps/surface/src/installation/**/*.ts",
    "apps/surface/src/server/**/*.ts",
    "apps/surface/src/runtime/**/*.ts",
    "apps/surface/src/workspaces/**/*.ts",
    "apps/surface/tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
