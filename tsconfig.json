{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "apps/installer/src/**/*.ts",
    "apps/surface/src/lib/server/**/*.ts",
    "packages/*/src/**/*.ts",
    "apps/surface/tests/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "apps/surface/.svelte-kit/ambient.d.ts"
  ]
}
