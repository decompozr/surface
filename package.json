{
  "name": "@decompozr/surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build:release": "bun scripts/release/build.ts",
    "dev": "bun apps/cli/src/index.ts serve",
    "test": "bun run --cwd apps/surface build && bun test apps/surface/tests apps/cli/tests tests/unit tests/e2e/runtime/interactions.test.ts",
    "check": "tsc --noEmit",
    "verify:mcp": "bun tests/e2e/mcp/verify.ts",
    "verify:project-access": "bun tests/e2e/mcp/verify-projects.ts",
    "surface": "bun apps/cli/src/index.ts",
    "verify:surface": "bun tests/e2e/surface/run.ts",
    "reply": "bun apps/cli/src/reply.ts",
    "test:e2e:comments": "bun tests/e2e/comments/run.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.20.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "@decompozr/surface-app": "workspace:*",
    "@decompozr/surface-cli": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "bin": {
    "surface": "./apps/cli/src/index.ts"
  },
  "exports": {
    "./interactions": "./apps/surface/src/lib/interactions/index.ts"
  },
  "workspaces": [
    "apps/surface",
    "apps/cli"
  ]
}
