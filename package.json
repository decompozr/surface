{
  "name": "@decompozr/surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build:release": "bun scripts/release/build.ts",
    "dev": "bun apps/surface/src/cli/index.ts serve",
    "test": "bun run --cwd apps/surface test:core",
    "test:singleton": "bun test apps/surface/runtime/interactions.test.ts",
    "check": "tsc --noEmit",
    "check:ui": "bun run --bun --cwd examples/svelte-feedback check",
    "build:ui": "bun run --bun --cwd examples/svelte-feedback build",
    "verify:external": "bun scripts/verify-external.ts",
    "singleton": "bun apps/surface/runtime/cli.ts",
    "verify:singleton": "bun apps/surface/runtime/verify.ts",
    "verify:singleton-interactions": "bun apps/surface/runtime/verify-interactions.ts",
    "verify:dependencies": "bun apps/surface/runtime/verify-dependencies.ts",
    "verify:soak": "bun apps/surface/runtime/verify-soak.ts",
    "verify:mcp": "bun apps/surface/mcp/verify.ts",
    "verify:sveltekit": "bun experiments/sveltekit/verify.ts",
    "verify:projects": "bun experiments/projects/verify.ts",
    "verify:installation": "bun experiments/lifecycle/verify.ts",
    "verify:project-access": "bun apps/surface/mcp/verify-projects.ts",
    "check:project-database": "tsc --noEmit -p experiments/project-database/tsconfig.json",
    "verify:project-database": "bun experiments/project-database/verify.ts",
    "check:server-contract": "tsc --noEmit -p experiments/server-contract/tsconfig.json",
    "verify:server-contract": "bun experiments/server-contract/verify.ts",
    "surface": "bun apps/surface/src/cli/index.ts",
    "check:workspaces": "tsc --noEmit -p experiments/workspaces/tsconfig.json",
    "verify:workspaces": "bun experiments/workspaces/verify.ts",
    "verify:surface": "bun scripts/verify-surface.ts",
    "verify:surface-workspaces": "bun experiments/workspaces/verify.ts --public-cli",
    "check:multi-surface": "tsc --noEmit -p experiments/multi-surface/tsconfig.json",
    "verify:multi-surface": "bun experiments/multi-surface/verify.ts",
    "check:surface-sync": "tsc --noEmit -p experiments/surface-sync/tsconfig.json",
    "verify:surface-sync": "bun experiments/surface-sync/verify.ts",
    "reply": "bun apps/surface/comments/result.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.20.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3"
  },
  "bin": {
    "surface": "./apps/surface/src/cli/index.ts"
  },
  "exports": {
    "./client": "./apps/surface/src/client/index.ts"
  }
}
